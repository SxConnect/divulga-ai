{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "rootDirectory": "frontend",
  "regions": ["gru1"],
  "functions": {
    "src/app/**/*.tsx": {
      "maxDuration": 30
    }
  },
  "env": {
    "NEXT_PUBLIC_API_URL": "@divulga-backend-url"
  },
  "headers": [
    {
      "source": "/files/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://divulga-backend.railway.app/api/:path*"
    },
    {
      "source": "/files/:path*",
      "destination": "https://divulga-backend.railway.app/files/:path*"
    }
  ]
}