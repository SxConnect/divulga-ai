# ============================================================
# Divulga.AI — Variáveis de Ambiente de PRODUÇÃO
# ============================================================
# Copie para .env.production (backend) e .env.production.local (frontend)
# NUNCA commite arquivos .env com segredos reais.
#
# BACKEND (Railway):
#   railway variables set --from-file backend/.env.production
#
# FRONTEND (Vercel):
#   Defina cada variável no painel do Vercel (Project Settings → Environment Variables)
# ============================================================

# ------------------------------------------------------------------
# DATABASE (Neon)
# ------------------------------------------------------------------
# Connection string POOLED (para a aplicação) — use o pooler do Neon
DATABASE_URL="postgresql://usuario:senha@ep-xxx-pooler.region.aws.neon.tech/divulga_ai?sslmode=require"

# Connection string DIRETA (apenas para migrations: prisma migrate deploy)
# Deve apontar para o endpoint direto do Neon (sem pooler)
DIRECT_URL="postgresql://usuario:senha@ep-xxx.region.aws.neon.tech/divulga_ai?sslmode=require"

# ------------------------------------------------------------------
# REDIS (Railway Redis Add-on)
# ------------------------------------------------------------------
# O Railway preenche automaticamente se você adicionar o add-on Redis
# REDIS_HOST=redis.railway.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=senha-do-redis
# REDIS_TLS=true

# ------------------------------------------------------------------
# AUTH & SEGURANÇA (OBRIGATÓRIO EM PRODUÇÃO)
# ------------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET="cole-aqui-64-chars-hex"
MASTER_ENCRYPTION_KEY="cole-aqui-64-chars-hex"

# ------------------------------------------------------------------
# URLS PÚBLICAS (OBRIGATÓRIO EM PRODUÇÃO)
# ------------------------------------------------------------------
# Domínio do backend no Railway (ex: https://divulga-backend.railway.app)
PUBLIC_BASE_URL="https://seu-backend.railway.app"

# Domínio do frontend no Vercel (ex: https://divulga-ai.vercel.app)
FRONTEND_URL="https://seu-frontend.vercel.app"

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN="https://seu-frontend.vercel.app"

# ------------------------------------------------------------------
# FACEBOOK OAUTH
# ------------------------------------------------------------------
# Configure no Facebook Developers: Valid OAuth Redirect URIs
# Deve apontar para o backend: https://seu-backend.railway.app/api/v1/integrations/facebook/callback
FACEBOOK_APP_ID="seu-app-id"
FACEBOOK_APP_SECRET="seu-app-secret"
FACEBOOK_REDIRECT_URI="https://seu-backend.railway.app/api/v1/integrations/facebook/callback"

# ------------------------------------------------------------------
# IA (OpenAI)
# ------------------------------------------------------------------
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-xxxxxxxxxxxxx"

# ------------------------------------------------------------------
# STORAGE (Cloudflare R2 — recomendado)
# ------------------------------------------------------------------
# Crie bucket no R2, gere API Token com permissão Object Read/Write
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=divulga-ai
# STORAGE_ACCESS_KEY=<access-key>
# STORAGE_SECRET_KEY=<secret-key>
# STORAGE_PUBLIC_URL=https://cdn.seudominio.com  (opcional: custom domain no R2)

# ------------------------------------------------------------------
# SERVER
# ------------------------------------------------------------------
# Railway injeta PORT automaticamente; não precisa definir
# PORT=3000

# ============================================================
# EXEMPLOS DE GERAÇÃO DE SEGREDOS
# ============================================================
# JWT_SECRET:           openssl rand -hex 32
# MASTER_ENCRYPTION_KEY: openssl rand -hex 32
#
# Ambos devem ter 64 caracteres hex (32 bytes).
# Em produção, NUNCA use os valores de exemplo do .env.example.
# ============================================================