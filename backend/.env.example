# Divulga.AI - Variáveis de Ambiente
# Copie para .env e ajuste: cp .env.example .env

# Database (porta publicada pelo docker-compose.yml)
DATABASE_URL="postgresql://divulga:divulga123@localhost:5435/divulga_ai"

# Redis (porta publicada pelo docker-compose.yml)
REDIS_HOST="localhost"
REDIS_PORT=6381

# JWT
JWT_SECRET="sua-chave-secreta-aqui-mude-em-producao"

# Server
PORT=4000
# URL pública do backend (usada para montar os links de /files/*)
PUBLIC_BASE_URL="http://localhost:4000"
# URL do frontend (retorno do OAuth do Facebook)
FRONTEND_URL="http://localhost:3001"
# Origens liberadas no CORS (separadas por vírgula). Vazio = aceita todas (dev)
CORS_ORIGIN="http://localhost:3001"

# Criptografia AES-256 (chave de 32 bytes em hex = 64 caracteres)
# Gerar com: openssl rand -hex 32
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# IA - Configurações dos provedores (preencher conforme necessário)
AI_PROVIDER="openai"  # openai | stability | replicate
OPENAI_API_KEY=""
STABILITY_API_KEY=""

# Storage local (uploads/) é o padrão. Preencha abaixo apenas se for usar S3.
STORAGE_BUCKET="divulga-ai"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Facebook Graph API
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:4000/api/v1/integrations/facebook/callback"

# TikTok
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
